{
  "users": [],
  "vhosts": [{ "name": "/" }],
  "permissions": [],
  "exchanges": [
    { "name": "payments.events", "vhost": "/", "type": "topic", "durable": true }
  ],
  "queues": [
    { "name": "payment.notifications", "vhost": "/", "durable": true },
    { "name": "payment.reconciliation", "vhost": "/", "durable": true }
  ],
  "bindings": [
    { "source": "payments.events", "vhost": "/", "destination": "payment.notifications", "destination_type": "queue", "routing_key": "payment.*" },
    { "source": "payments.events", "vhost": "/", "destination": "payment.reconciliation", "destination_type": "queue", "routing_key": "payment.unknown" }
  ]
}
